# ---------- core ----------
NODE_ENV=development
API_PORT=3000
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173

# ---------- database ----------
DATABASE_URL=postgresql://nivora:nivora@localhost:55432/nivora?schema=public

# ---------- auth ----------
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost

# ---------- storage ----------
# local | s3 | cloudinary | supabase
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./.storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_PUBLIC_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLOUDINARY_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------- payments ----------
# mock | stripe | paypal | konnect
PAYMENT_PROVIDER=mock
DEFAULT_CURRENCY=TND
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
KONNECT_API_KEY=
KONNECT_WALLET_ID=

# ---------- email ----------
# console | resend | sendgrid
EMAIL_PROVIDER=console
EMAIL_FROM="NIVORA <no-reply@nivora.tn>"
RESEND_API_KEY=
SENDGRID_API_KEY=

# ---------- ai providers (leave empty until configured) ----------
IMAGE_PROVIDER=
VIDEO_PROVIDER=
LOGO_PROVIDER=
AI_API_KEY=
AI_API_BASE_URL=
AI_WEBHOOK_SECRET=

# ---------- jobs ----------
# inprocess | bullmq
QUEUE_DRIVER=inprocess
REDIS_URL=redis://localhost:6379

# ---------- limits ----------
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_AUDIO_MB=20
RATE_LIMIT_PER_MIN=100
