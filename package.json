{
  "name": "nivora",
  "private": true,
  "version": "0.1.0",
  "description": "NIVORA — digital creative studio platform (monorepo)",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @nivora/api prisma generate",
    "db:migrate": "pnpm --filter @nivora/api prisma migrate dev",
    "db:seed": "pnpm --filter @nivora/api prisma db seed"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
